{
  "info": {
    "_postman_id": "techmovil-2026-api-collection",
    "name": "TechMovil API — Pruebas Integrales",
    "description": "Colección completa de pruebas de integración para el sistema TechMovil. Cubre todos los endpoints REST: Autenticación, Productos, Ventas, Facturas, Usuarios y Reportes. Incluye validaciones de parámetros de entrada (campos requeridos, tipos, límites y valores límite).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:8080", "type": "string" },
    { "key": "TOKEN", "value": "", "type": "string" },
    { "key": "PRODUCTO_ID", "value": "1", "type": "string" },
    { "key": "VENTA_ID", "value": "1", "type": "string" },
    { "key": "FACTURA_ID", "value": "1", "type": "string" },
    { "key": "USUARIO_ID", "value": "999999", "type": "string" },
    { "key": "VENDEDOR_USERNAME", "value": "vendedor_default", "type": "string" }
