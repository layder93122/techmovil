pipeline {
    agent any

    stages {
        stage('Compilación y Tests') {
            steps {
                dir('FINTECHMOVIL/backend') {
                    sh 'chmod +x mvnw'
                    sh './mvnw clean test'
                }
            }
        }

        stage('Análisis SonarQube') {
            steps {
                dir('FINTECHMOVIL/backend') {
                    // Ajusta este comando si usas Sonar Scanner
                    echo 'Ejecutando análisis SonarQube...'
                }
            }
        }

        stage('Construcción Docker') {
            steps {
                dir('FINTECHMOVIL/backend') {
                    // Ajusta según tus comandos de Docker
                    echo 'Construyendo imagen Docker...'
                }
            }
        }
    }
}
